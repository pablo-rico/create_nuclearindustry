{
  "multipart": [
    {
      "apply": {
        "model": "create_nuclearindustry:block/rocket_warhead/body_empty"
      },
      "when": {
        "charge": "empty"
      }
    },
    {
      "apply": {
        "model": "create_nuclearindustry:block/rocket_warhead/body_conventional"
      },
      "when": {
        "charge": "conventional"
      }
    },
    {
      "apply": {
        "model": "create_nuclearindustry:block/rocket_warhead/body_fission"
      },
      "when": {
        "charge": "fission"
      }
    },
    {
      "apply": {
        "model": "create_nuclearindustry:block/rocket_warhead/body_dirty"
      },
      "when": {
        "charge": "dirty"
      }
    },
    {
      "apply": {
        "model": "create_nuclearindustry:block/rocket_warhead/body_thermonuclear"
      },
      "when": {
        "charge": "thermonuclear"
      }
    },
    {
      "apply": {
        "model": "create_nuclearindustry:block/rocket_warhead/top_cap"
      },
      "when": {
