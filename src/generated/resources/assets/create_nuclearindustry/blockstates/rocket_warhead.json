      }
    },
    {
      "apply": {
        "model": "create_nuclearindustry:block/rocket_warhead/top_joint"
      },
      "when": {
        "top": "other"
      }
    },
    {
      "apply": {
        "model": "create_nuclearindustry:block/rocket_warhead/bottom_cap"
      },
      "when": {
        "bottom": "none"
      }
    },
    {
      "apply": {
        "model": "create_nuclearindustry:block/rocket_warhead/bottom_joint"
      },
      "when": {
        "bottom": "other"
      }
    }
  ]
