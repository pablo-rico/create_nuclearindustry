{
  "multipart": [
    {
      "apply": {
        "model": "create_nuclearindustry:block/rocket_engine/body_first"
      },
      "when": {
        "bottom": "none"
      }
    },
    {
      "apply": {
        "model": "create_nuclearindustry:block/rocket_engine/body_upper"
      },
      "when": {
        "bottom": "same|other"
      }
    },
    {
      "apply": {
        "model": "create_nuclearindustry:block/rocket_engine/top_cap"
      },
      "when": {
        "top": "none"
      }
    },
    {
      "apply": {
        "model": "create_nuclearindustry:block/rocket_engine/top_joint"
      },
      "when": {
        "top": "other"
      }
    },
    {
      "apply": {
        "model": "create_nuclearindustry:block/rocket_engine/bottom_cap"
      },
      "when": {
        "bottom": "none"
      }
    },
    {
      "apply": {
        "model": "create_nuclearindustry:block/rocket_engine/bottom_joint"
      },
      "when": {
        "bottom": "other"
      }
    }
  ]
}